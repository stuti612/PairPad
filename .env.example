# Copy to .env and fill in. .env is read at startup and never committed.
# Every provider below has a free tier that needs no credit card.

# --- AI collaborator ---------------------------------------------------------
# Primary: Groq. Free key at https://console.groq.com/keys
GROQ_API_KEY=

# Fallback when Groq is rate limited: GitHub Models. Use a fine-grained personal
# access token with the "Models: read" permission:
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# Optional switches (defaults shown)
# AI_PROVIDER=groq              # groq | github | openrouter | cerebras | custom | mock | off
# AI_FALLBACK_PROVIDER=github   # any of the above, or none
# AI_ROOM_HOURLY_LIMIT=10       # AI requests per pad per hour
# AI_DAILY_LIMIT=100            # AI requests per day, whole server
# AI_TIMEOUT_MS=60000

# Optional overrides, per provider (prefix GROQ_, GITHUB_, OPENROUTER_, CEREBRAS_, CUSTOM_)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_JUDGE_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_JSON_MODE=json_schema    # or json_object

# OpenRouter (free ":free" models only; 50 requests/day without credits)
# OPENROUTER_API_KEY=

# Any other OpenAI-compatible endpoint, e.g. a local Ollama
# AI_PROVIDER=custom
# CUSTOM_BASE_URL=http://localhost:11434/v1
# CUSTOM_API_KEY=ollama
# CUSTOM_MODEL=
# CUSTOM_JUDGE_MODEL=

# --- Storage -----------------------------------------------------------------
# DATABASE_URL=postgres://...   # leave unset locally to use SQLite
